# Copy this file to `.env` and fill in real values.

# --- Database ---
# Local development uses SQLite:
DATABASE_URL="file:./dev.db"
#
# For production, switch to PostgreSQL and update the Prisma adapter in
# src/lib/prisma.ts (see README "Going to production"):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?schema=public"

# --- Auth ---
# REQUIRED in production. Secret used to sign session cookies (JWT). If this is
# unset with NODE_ENV=production the app refuses to start (rather than silently
# using an insecure default that would allow forged admin sessions). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Seeding (optional) ---
# The one-tap demo login buttons only render in development builds; the demo
# phone numbers/password are compiled out of production bundles entirely.
#
# `npm run seed` wipes the DB and creates demo accounts (incl. a public-password
# admin). It refuses to run with NODE_ENV=production unless you also set:
# ALLOW_PROD_SEED="true"
