// Prisma schema for the Learning Center management app.
// Docs: https://pris.ly/d/prisma-schema
//
// Note: SQLite (dev) does not support native enums, so role/type fields are
// stored as String and validated in the app layer (see src/lib/constants.ts
// and src/lib/validations.ts). This keeps an easy migration path to Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Application user. One table for all four roles (ADMIN | TEACHER | STUDENT | CEO).
model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique // login identifier (replaces email)
  passwordHash String
  role         String // "ADMIN" | "TEACHER" | "STUDENT" | "CEO"
  avatarUrl    String?
  active       Boolean   @default(true)
  // When a student (or any user) was marked inactive/left. Null while active.
  // Drives the CEO dashboard's "left this month" count.
  leftAt       DateTime?

  // Coin balance (students earn coins from teachers and spend them in the shop).
  coins Int @default(0)

  // Admin-granted exemption: this student may still earn coins from
  // teachers even while not paid up (e.g. documented financial hardship).
  // Independent of payment status — has no effect on finance reporting.
  coinWaiver Boolean @default(false)

  // Fixed monthly salary for TEACHER accounts, set by the CEO. Unused by
  // other roles.
  salary Float?

  // Relations.
  // Students are enrolled into groups (classes) — implicit many-to-many. A
  // student may study any number of subjects (2+). A teacher owns the groups
  // they teach via "GroupTeacher".
  enrolledGroups   Group[]           @relation("GroupStudents")
  groupsTaught     Group[]           @relation("GroupTeacher")
  gradesReceived   Grade[]           @relation("StudentGrades")
  gradesGiven      Grade[]           @relation("TeacherGrades")
  attendances      Attendance[]
  orders           Order[]           @relation("StudentOrders")
  roomAssignments  RoomAssignment[]  @relation("TeacherRoomAssignments")
  payments         Payment[]         @relation("StudentPayments")
  payouts          TeacherPayout[]   @relation("TeacherPayouts")
  paymentsRecorded Payment[]         @relation("PaymentRecorder")
  paymentShares    Payment[]         @relation("PaymentTeacher")
  expenses         Expense[]         @relation("ExpenseCreator")
  feedbackSent     TeacherFeedback[] @relation("FeedbackStudent")
  feedbackReceived TeacherFeedback[] @relation("FeedbackTeacher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

/// A subject / "sphere" of study. Groups (classes) live under a subject.
model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  groups      Group[]
  grades      Grade[]
  createdAt   DateTime @default(now())
}

/// A class within a subject. Has one teacher and a roster of enrolled students.
model Group {
  id        String  @id @default(cuid())
  name      String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  // The teacher of this class (optional — a class can exist before a teacher
  // is assigned). Cleared if the teacher account is removed.
  teacher   User?   @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?

  // Enrolled students (implicit many-to-many).
  students User[] @relation("GroupStudents")

  // Scheduling: a weekly timetable and the concrete lessons generated from it.
  schedules ClassSchedule[]
  lessons   Lesson[]
  payments  Payment[]
  feedback  TeacherFeedback[]

  createdAt DateTime @default(now())

  @@unique([subjectId, name])
  @@index([subjectId])
  @@index([teacherId])
}

/// A single mark/grade given to a student in a subject by a teacher.
model Grade {
  id        String  @id @default(cuid())
  student   User    @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  teacher   User    @relation("TeacherGrades", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String

  value    Float
  maxValue Float    @default(100)
  type     String // "EXAM" | "QUIZ" | "HOMEWORK" | "PROJECT"
  comment  String?
  date     DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([studentId, subjectId])
  @@index([date])
}

/// A physical room lessons can be held in.
model Room {
  id          String           @id @default(cuid())
  name        String           @unique
  capacity    Int?
  schedules   ClassSchedule[]
  lessons     Lesson[]
  assignments RoomAssignment[]
  createdAt   DateTime         @default(now())
}

/// A recurring weekly timetable entry for a class (e.g. "Mon 15:00, Room 2").
/// Concrete Lesson rows are generated from these.
model ClassSchedule {
  id          String  @id @default(cuid())
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  weekday     Int // 1 = Monday … 7 = Sunday
  startTime   String // "HH:MM" (24h)
  durationMin Int     @default(90)
  room        Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId      String?

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([roomId])
}

/// A concrete lesson on the calendar. Generated from a ClassSchedule, but each
/// one can be renamed, moved (startAt/endAt/room) or cancelled independently.
model Lesson {
  id      String   @id @default(cuid())
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  title   String? // optional label; defaults to the subject/class name in the UI
  type    String   @default("TYPICAL") // "TYPICAL" | "EXAM" (bounds the coins a teacher can give)
  startAt DateTime
  endAt   DateTime
  room    Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId  String?
  status  String   @default("SCHEDULED") // "SCHEDULED" | "CANCELLED"

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, startAt])
  @@index([groupId, startAt])
  @@index([startAt])
}

/// A student's attendance for a single lesson (present/absent + reason).
model Attendance {
  id        String   @id @default(cuid())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  status    String // "PRESENT" | "ABSENT"
  reason    String?
  coins     Int      @default(0) // coins the teacher awarded this student for this lesson
  markedAt  DateTime @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([status])
}

/// A product a student can buy from the coin shop with earned coins.
model Product {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String? // optional image (URL or data URI)
  info      String? // description / information
  price     Int // cost in coins
  stock     Int      @default(0) // availability number remaining
  disabled  Boolean  @default(false) // hidden from the shop when true
  orders    Order[]
  createdAt DateTime @default(now())
}

/// A student's order placed from the coin shop. Coins are deducted when placed;
/// admins deliver (fulfil) or reject (refund + restock) it.
model Order {
  id          String   @id @default(cuid())
  student     User     @relation("StudentOrders", fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String // snapshot of the product name at order time
  quantity    Int      @default(1) // how many units were ordered
  coinsSpent  Int // total coins deducted from the student (price × quantity; refunded on reject)
  status      String   @default("PENDING") // "PENDING" | "DELIVERED" | "REJECTED"
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([studentId])
}

/// A teacher assigned to a room for a weekly time slot (admin-managed). Drives
/// the teacher's "class hours" and blocks the room for that time.
model RoomAssignment {
  id        String   @id @default(cuid())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  teacher   User     @relation("TeacherRoomAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  weekday   Int // 1 = Monday … 7 = Sunday
  startTime String // "HH:MM" (24h)
  endTime   String // "HH:MM" (24h)
  createdAt DateTime @default(now())

  @@index([roomId, weekday])
  @@index([teacherId])
}

/// Center-wide finance configuration. Single row (id = "singleton"). The
/// tuition fee is fixed by the administrator and applies to every student;
/// each Payment snapshots the fee in effect when it was recorded so past
/// cycles stay accurate if the fee later changes.
model FinanceSettings {
  id          String   @id @default("singleton")
  tuitionFee  Float    @default(0)
  companyName String   @default("Brian") // shown on printed receipts
  branchName  String? // optional branch/filial name on receipts

  // Two-tier coin incentive for paying on time (day cutoffs are fixed
  // constants — see VERY_EARLY_PAYMENT_DAY / EARLY_PAYMENT_DAY in
  // lib/constants.ts). The bigger, more-exclusive tier wins when a payment
  // qualifies for both. 0 disables a tier.
  veryEarlyBonusCoins Int @default(0)
  earlyBonusCoins     Int @default(0)

  updatedAt DateTime @updatedAt
}

/// One tuition billing cycle for a student. Cycles are monthly, rolling from
/// whenever the student last paid: as soon as a payment is recorded, the next
/// cycle's row is created with dueDate = paidAt + 1 month. `paidAt` is null
/// until the administrator marks it paid, so a student always has at most one
/// open (unpaid) cycle — a due-date "overdue" state is derived in the app
/// layer from `dueDate` vs. today, not stored.
model Payment {
  id        String    @id @default(cuid())
  student   User      @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  amount    Float
  dueDate   DateTime
  paidAt    DateTime?

  // Receipt details (filled when a payment is actually recorded/paid).
  method       String  @default("CASH") // "CASH" | "CLICK" | "CARD" | "TRANSFER"
  receiptNo    Int? // sequential human-facing receipt number
  group        Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId      String?
  recordedBy   User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?

  // Optional teacher revenue-share: a percentage of this payment allocated to a
  // teacher as their earning. teacherShareAmount snapshots amount * pct / 100.
  // The share is only a real, countable payout once the CEO confirms it —
  // teacherShareConfirmedAt is null while it's awaiting confirmation.
  teacher                 User?     @relation("PaymentTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId               String?
  teacherSharePct         Float?
  teacherShareAmount      Float?
  teacherShareConfirmedAt DateTime?

  // Snapshot of the early-payment coin bonus granted when this cycle was
  // paid (0 if none/ineligible). Kept even if the finance setting later
  // changes, and reversed if the payment is undone.
  bonusCoins Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([dueDate])
  @@index([paidAt])
  @@index([teacherId])
}

/// A free-form business expense logged by the CEO (electricity, gas, rent…).
/// Subtracted from revenue when computing net profit.
model Expense {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  date        DateTime @default(now())
  createdBy   User?    @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([date])
}

/// One monthly salary payout for a teacher, tracked by the CEO. `period` is a
/// "YYYY-MM" label identifying the calendar month being paid.
model TeacherPayout {
  id        String    @id @default(cuid())
  teacher   User      @relation("TeacherPayouts", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  period    String
  amount    Float
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, period])
  @@index([teacherId])
  @@index([period])
}

/// A comment a student leaves for one of their teachers. The teacher must
/// actually teach the student (enforced in the app layer) — students can't
/// leave feedback for arbitrary teachers.
model TeacherFeedback {
  id        String  @id @default(cuid())
  student   User    @relation("FeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  teacher   User    @relation("FeedbackTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId   String?
  message   String

  createdAt DateTime @default(now())

  @@index([teacherId])
  @@index([studentId])
}
