// Prisma schema for the Learning Center management app.
// Docs: https://pris.ly/d/prisma-schema
//
// Note: SQLite (dev) does not support native enums, so role/type fields are
// stored as String and validated in the app layer (see src/lib/constants.ts
// and src/lib/validations.ts). This keeps an easy migration path to Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Application user. One table for all three roles (ADMIN | TEACHER | STUDENT).
model User {
  id           String  @id @default(cuid())
  name         String
  phone        String  @unique // login identifier (replaces email)
  passwordHash String
  role         String // "ADMIN" | "TEACHER" | "STUDENT"
  avatarUrl    String?
  active       Boolean @default(true)

  // Coin balance (students earn coins from teachers and spend them in the shop).
  coins Int @default(0)

  // Relations.
  // Students are enrolled into groups (classes) — implicit many-to-many. A
  // student may study any number of subjects (2+). A teacher owns the groups
  // they teach via "GroupTeacher".
  enrolledGroups  Group[]          @relation("GroupStudents")
  groupsTaught    Group[]          @relation("GroupTeacher")
  gradesReceived  Grade[]          @relation("StudentGrades")
  gradesGiven     Grade[]          @relation("TeacherGrades")
  attendances     Attendance[]
  orders          Order[]          @relation("StudentOrders")
  roomAssignments RoomAssignment[] @relation("TeacherRoomAssignments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

/// A subject / "sphere" of study. Groups (classes) live under a subject.
model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  groups      Group[]
  grades      Grade[]
  createdAt   DateTime @default(now())
}

/// A class within a subject. Has one teacher and a roster of enrolled students.
model Group {
  id        String  @id @default(cuid())
  name      String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  // The teacher of this class (optional — a class can exist before a teacher
  // is assigned). Cleared if the teacher account is removed.
  teacher   User?   @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?

  // Enrolled students (implicit many-to-many).
  students User[] @relation("GroupStudents")

  // Scheduling: a weekly timetable and the concrete lessons generated from it.
  schedules ClassSchedule[]
  lessons   Lesson[]

  createdAt DateTime @default(now())

  @@unique([subjectId, name])
  @@index([subjectId])
  @@index([teacherId])
}

/// A single mark/grade given to a student in a subject by a teacher.
model Grade {
  id        String  @id @default(cuid())
  student   User    @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  teacher   User    @relation("TeacherGrades", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String

  value    Float
  maxValue Float    @default(100)
  type     String // "EXAM" | "QUIZ" | "HOMEWORK" | "PROJECT"
  comment  String?
  date     DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([studentId, subjectId])
  @@index([date])
}

/// A physical room lessons can be held in.
model Room {
  id          String           @id @default(cuid())
  name        String           @unique
  capacity    Int?
  schedules   ClassSchedule[]
  lessons     Lesson[]
  assignments RoomAssignment[]
  createdAt   DateTime         @default(now())
}

/// A recurring weekly timetable entry for a class (e.g. "Mon 15:00, Room 2").
/// Concrete Lesson rows are generated from these.
model ClassSchedule {
  id          String  @id @default(cuid())
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  weekday     Int // 1 = Monday … 7 = Sunday
  startTime   String // "HH:MM" (24h)
  durationMin Int     @default(90)
  room        Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId      String?

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([roomId])
}

/// A concrete lesson on the calendar. Generated from a ClassSchedule, but each
/// one can be renamed, moved (startAt/endAt/room) or cancelled independently.
model Lesson {
  id        String  @id @default(cuid())
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  title     String? // optional label; defaults to the subject/class name in the UI
  type      String  @default("TYPICAL") // "TYPICAL" | "EXAM" (bounds the coins a teacher can give)
  startAt   DateTime
  endAt     DateTime
  room      Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId    String?
  status    String  @default("SCHEDULED") // "SCHEDULED" | "CANCELLED"

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, startAt])
  @@index([groupId, startAt])
  @@index([startAt])
}

/// A student's attendance for a single lesson (present/absent + reason).
model Attendance {
  id        String  @id @default(cuid())
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  status    String // "PRESENT" | "ABSENT"
  reason    String?
  coins     Int      @default(0) // coins the teacher awarded this student for this lesson
  markedAt  DateTime @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([status])
}

/// A product a student can buy from the coin shop with earned coins.
model Product {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String? // optional image (URL or data URI)
  info      String? // description / information
  price     Int // cost in coins
  stock     Int      @default(0) // availability number remaining
  disabled  Boolean  @default(false) // hidden from the shop when true
  orders    Order[]
  createdAt DateTime @default(now())
}

/// A student's order placed from the coin shop. Coins are deducted when placed;
/// admins deliver (fulfil) or reject (refund + restock) it.
model Order {
  id          String   @id @default(cuid())
  student     User     @relation("StudentOrders", fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String // snapshot of the product name at order time
  coinsSpent  Int // coins deducted from the student (refunded on reject)
  status      String   @default("PENDING") // "PENDING" | "DELIVERED" | "REJECTED"
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([studentId])
}

/// A teacher assigned to a room for a weekly time slot (admin-managed). Drives
/// the teacher's "class hours" and blocks the room for that time.
model RoomAssignment {
  id        String   @id @default(cuid())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  teacher   User     @relation("TeacherRoomAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  weekday   Int // 1 = Monday … 7 = Sunday
  startTime String // "HH:MM" (24h)
  endTime   String // "HH:MM" (24h)
  createdAt DateTime @default(now())

  @@index([roomId, weekday])
  @@index([teacherId])
}
